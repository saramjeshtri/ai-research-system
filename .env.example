# Copy this file to .env and fill in the real values.
# .env is git-ignored — it must NEVER be committed (this repo is public).
# Share the real values with teammates through Bitwarden, not through Git.

# --- LLM ---
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_MODEL=
EMBEDDING_DIM=

# --- Database (PostgreSQL + pgvector) ---
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=research
POSTGRES_USER=research
POSTGRES_PASSWORD=

# --- VPS ---
VPS_HOST=
